<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NhanCMS Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            margin: 0;
        }

        /* Sidebar Styling */
        .sidebar {
            min-height: 100vh;
            background-color: #1e2229;
            color: #eceff2;
            box-shadow: 4px 0 10px rgba(0,0,0,0.1);
            z-index: 1000;
        }

            .sidebar .brand-link {
                background-color: #1a1d24;
                padding: 20px;
                text-align: center;
                border-bottom: 1px solid #2d353e;
            }

            .sidebar a {
                color: #abb4be;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 20px;
                transition: all 0.3s ease;
                border-left: 4px solid transparent;
                font-size: 0.95rem;
            }

                .sidebar a:hover {
                    background-color: #282e38;
                    color: #ffffff;
                    border-left-color: #0d6efd;
                }

                .sidebar a.active {
                    background-color: rgba(13, 110, 253, 0.15);
                    color: #0d6efd;
                    border-left-color: #0d6efd;
                    font-weight: 600;
                }

        .menu-header {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #56616a;
            padding: 20px 20px 8px 20px;
            font-weight: 800;
        }

        /* Main Content Styling */
        .top-navbar {
            background-color: #ffffff;
            padding: 12px 30px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        }

        .main-content-wrapper {
            padding: 30px;
        }

        .main-content-card {
            background-color: #ffffff;
            min-height: 80vh;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
            padding: 25px;
            border: 1px solid rgba(0,0,0,0.05);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #999;
            }
    </style>
</head>
<body>
    @{
        // Lấy tên Controller hiện tại để làm hiệu ứng Active Menu
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div class="container-fluid p-0">
        <div class="row g-0">
            <nav class="col-md-3 col-lg-2 sidebar d-none d-md-block position-fixed">
                <div class="brand-link">
                    <h5 class="text-white mb-0 fw-bold"><i class="bi bi-cpu-fill text-info"></i> NhanCMS Admin</h5>
                </div>

                <div class="mt-3 overflow-auto" style="height: calc(100vh - 80px);">
                    <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2 text-warning"></i> Bảng điều khiển
                    </a>

                    <div class="menu-header">NỘI DUNG (CMS)</div>
                    <a asp-controller="CategoryPost" asp-action="Index" class="@(currentController == "CategoryPost" ? "active" : "")">
                        <i class="bi bi-grid-1x2 text-success"></i> Danh mục tin tức
                    </a>
                    <a asp-controller="Post" asp-action="Index" class="@(currentController == "Post" ? "active" : "")">
                        <i class="bi bi-file-earmark-post text-info"></i> Bài viết tin tức
                    </a>
                    <a asp-controller="Banner" asp-action="Index" class="@(currentController == "Banner" ? "active" : "")">
                        <i class="bi bi-images text-warning"></i> Quản lý Banner
                    </a>

                    @if(User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <div class="menu-header">KINH DOANH (E-COM)</div>
                        <a asp-controller="ProductCategory" asp-action="Index" class="@(currentController == "ProductCategory" ? "active" : "")">
                            <i class="bi bi-tags text-primary"></i> Danh mục sản phẩm
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="@(currentController == "Product" ? "active" : "")">
                            <i class="bi bi-box-seam text-danger"></i> Quản lý Sản phẩm
                        </a>
                        <a asp-controller="Customer" asp-action="Index" class="@(currentController == "Customer" ? "active" : "")">
                            <i class="bi bi-person-bounding-box text-warning"></i> Khách hàng
                        </a>
                        <a asp-controller="Order" asp-action="Index" class="@(currentController == "Order" ? "active" : "")">
                            <i class="bi bi-receipt text-success"></i> Đơn đặt hàng
                        </a>

                        <div class="menu-header">HỆ THỐNG</div>
                        <a asp-controller="User" asp-action="Index" class="@(currentController == "User" ? "active" : "")">
                            <i class="bi bi-people-fill text-light"></i> Quản lý Thành viên
                        </a>
                    }

                    <div style="height: 50px;"></div>
                </div>
            </nav>

            <main class="col-md-9 col-lg-10 ms-sm-auto">
                <header class="top-navbar d-flex justify-content-between align-items-center sticky-top">
                    <div class="text-muted small fw-bold d-none d-sm-block">
                        Hệ thống quản trị bài viết & bán hàng
                    </div>
                    <div class="d-block d-sm-none fw-bold text-primary">
                        <i class="bi bi-cpu-fill"></i> NhanCMS
                    </div>

                    <div class="dropdown ms-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <button class="btn btn-link text-dark text-decoration-none dropdown-toggle p-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <div class="d-inline-flex justify-content-center align-items-center bg-primary bg-opacity-10 text-primary rounded-circle" style="width: 32px; height: 32px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span>Chào, <strong>@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</strong></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3" style="min-width: 200px;">
                                <li class="px-3 py-2 border-bottom mb-1 bg-light rounded-top-3">
                                    <div class="small text-muted">Vai trò hiện tại</div>
                                    <div class="fw-bold text-primary">
                                        @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Thành viên")
                                    </div>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="User" asp-action="Edit" asp-route-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
                                        <i class="bi bi-person-gear me-2 text-muted"></i>Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item py-2 text-danger fw-semibold d-flex align-items-center">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                            </a>
                        }
                    </div>
                </header>

                <div class="main-content-wrapper">
                    <div class="main-content-card">
                        @RenderBody()
                    </div>

                    <footer class="mt-4 text-center text-muted small">
                        &copy; @DateTime.Now.Year - <strong>ThaiCMS</strong> - Thiết kế bởi Biện Văn Nhân
                    </footer>
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>