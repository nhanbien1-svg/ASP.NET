@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Ch?nh s?a bài vi?t";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark fw-bold m-0 text-uppercase">
            <i class="bi bi-pencil-square text-warning me-2"></i>C?P NH?T BÀI VI?T
        </h3>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="postForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm rounded-3"></div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />
        <input type="hidden" asp-for="CreatedDate" />
        <input type="hidden" asp-for="ViewCount" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm border-warning border-2 rounded-4 mb-4">
                    <div class="card-body p-4">

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold fs-5">Tiêu d? bài vi?t <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control form-control-lg border-warning border-opacity-50" placeholder="Nh?p tiêu d?..." required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 bg-light p-3 rounded-3 border">
                            <label asp-for="Slug" class="form-label fw-bold text-muted"><i class="bi bi-link-45deg"></i> Ðu?ng d?n tinh (SEO Link)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted">ten-mien.com/</span>
                                <input asp-for="Slug" class="form-control text-primary font-monospace" />
                            </div>
                            <small class="text-muted mt-1 d-block">Ð? tr?ng h? th?ng s? t? d?ng làm m?i link chu?n SEO t? Tiêu d?.</small>
                            <span asp-validation-for="Slug" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Summary" class="form-label fw-bold">Ðo?n mô t? ng?n (Sapo)</label>
                            <textarea asp-for="Summary" class="form-control" rows="3" placeholder="Ðo?n van ng?n xu?t hi?n du?i tiêu d? ? trang ch?..."></textarea>
                            <span asp-validation-for="Summary" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold fs-5">N?i dung chi ti?t <span class="text-danger">*</span></label>
                            <textarea asp-for="Content" id="editor" class="form-control"></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-rocket-takeoff"></i> Xu?t b?n</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="form-check form-switch fs-5 mb-4 border p-3 rounded-3 bg-light">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="IsPublished">
                            <label class="form-check-label ms-2 fw-bold text-success" asp-for="IsPublished">
                                Xu?t b?n (Công khai)
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold shadow-sm text-dark">
                                <i class="bi bi-check-circle"></i> C?p nh?t thay d?i
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                                H?y & Quay l?i
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-tags"></i> Phân lo?i</h5>
                    </div>
                    <div class="card-body p-4">
                        <label asp-for="CategoryPostId" class="form-label fw-bold">Chuyên m?c tin t?c <span class="text-danger">*</span></label>
                        <select asp-for="CategoryPostId" class="form-select form-select-lg" asp-items="ViewBag.CategoryList" required>
                            <option value="">-- L?a ch?n chuyên m?c --</option>
                        </select>
                        <span asp-validation-for="CategoryPostId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-image"></i> ?nh d?i di?n</h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        <div class="mb-3 d-flex justify-content-center">
                            <div class="border bg-light rounded-3 p-1 shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 100%; height: 200px;">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img id="imagePreview" src="@Model.ImageUrl" class="img-fluid rounded" style="width: 100%; height: 100%; object-fit: cover;" alt="Current Image" />
                                }
                                else
                                {
                                    <img id="imagePreview" src="https://via.placeholder.com/400x250?text=Chua+có+?nh" class="img-fluid rounded opacity-50" style="width: 100%; height: 100%; object-fit: cover;" alt="No Image" />
                                }
                            </div>
                        </div>
                        <input type="file" name="uploadImage" class="form-control" accept="image/*" id="imageInput" />
                        <small class="text-muted mt-2 d-block text-start">?? B? tr?ng n?u mu?n gi? nguyên ?nh cu.</small>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('imageInput').onchange = function(evt) {
            const [file] = this.files;
            if (file) {
                const preview = document.getElementById('imagePreview');
                preview.src = URL.createObjectURL(file);
                preview.classList.remove('opacity-50');
                preview.onload = function() { URL.revokeObjectURL(preview.src); }
            }
        };
    </script>

    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'), {
                toolbar: [ 'heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 'imageUpload', 'blockQuote', '|', 'undo', 'redo' ],
                ckfinder: {
                    uploadUrl: '/api/upload/ckeditor'
                }
            })
            .catch(error => {
                console.error(error);
            });
    </script>
}
