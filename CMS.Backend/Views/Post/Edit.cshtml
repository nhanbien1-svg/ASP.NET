@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> CHỈNH SỬA BÀI VIẾT</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Tiêu đề bài viết:</label>
                    <input asp-for="Title" class="form-control" required />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Chuyên mục:</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList" required>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Ngày đăng:</label>
                        <input asp-for="CreatedDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ảnh đại diện hiện tại:</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="Ảnh bài viết" style="max-height: 150px; border-radius: 8px;" class="shadow-sm" />
                        </div>
                    }
                    <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                    <small class="text-muted">Chọn ảnh mới nếu muốn thay thế ảnh cũ.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Nội dung chi tiết:</label>
                    <textarea asp-for="Content" class="form-control" rows="8"></textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="bi bi-save"></i> Cập nhật thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>