@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm bài viết mới";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark fw-bold m-0 text-uppercase">
            <i class="bi bi-file-earmark-plus-fill text-primary me-2"></i>SOẠN THẢO BÀI VIẾT TỨC MỚI
        </h3>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="postForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm rounded-3"></div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4">

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold fs-5">Tiêu đề bài viết <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control form-control-lg border-primary border-opacity-25" placeholder="Nhập tiêu đề thật hấp dẫn..." required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 bg-light p-3 rounded-3 border">
                            <label asp-for="Slug" class="form-label fw-bold text-muted"><i class="bi bi-link-45deg"></i> Đường dẫn tĩnh (SEO Link)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted">ten-mien.com/</span>
                                <input asp-for="Slug" class="form-control text-primary font-monospace" placeholder="bo-trong-de-tu-dong-tao-link" />
                            </div>
                            <small class="text-muted mt-1 d-block">Để trống hệ thống sẽ tự động tạo link chuẩn SEO từ Tiêu đề.</small>
                            <span asp-validation-for="Slug" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Summary" class="form-label fw-bold">Đoạn mô tả ngắn (Sapo)</label>
                            <textarea asp-for="Summary" class="form-control" rows="3" placeholder="Đoạn văn ngắn xuất hiện dưới tiêu đề ở trang chủ để thu hút người đọc..."></textarea>
                            <span asp-validation-for="Summary" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold fs-5">Nội dung chi tiết <span class="text-danger">*</span></label>
                            <textarea asp-for="Content" id="editor" class="form-control"></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-rocket-takeoff"></i> Xuất bản</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="form-check form-switch fs-5 mb-4 border p-3 rounded-3 bg-light">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="IsPublished" checked>
                            <label class="form-check-label ms-2 fw-bold text-success" asp-for="IsPublished">
                                Đăng tải ngay lập tức
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                                <i class="bi bi-cloud-arrow-up"></i> Lưu bài viết
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                                Hủy & Quay lại
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-tags"></i> Phân loại</h5>
                    </div>
                    <div class="card-body p-4">
                        <label asp-for="CategoryPostId" class="form-label fw-bold">Chuyên mục tin tức <span class="text-danger">*</span></label>
                        <select asp-for="CategoryPostId" class="form-select form-select-lg" asp-items="ViewBag.CategoryList" required>
                            <option value="">-- Lựa chọn chuyên mục --</option>
                        </select>
                        <span asp-validation-for="CategoryPostId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-image"></i> Ảnh đại diện</h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        <div class="mb-3 d-flex justify-content-center">
                            <div class="border bg-light rounded-3 p-1 shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 100%; height: 200px;">
                                <img id="imagePreview" src="https://via.placeholder.com/400x250?text=Chưa+chọn+ảnh" class="img-fluid rounded" style="width: 100%; height: 100%; object-fit: cover;" alt="Xem trước" />
                            </div>
                        </div>
                        <input type="file" name="uploadImage" class="form-control" accept="image/*" id="imageInput" />
                        <small class="text-muted mt-2 d-block text-start">Khuyến nghị: Ảnh tỉ lệ 16:9 (Ví dụ: 800x450px).</small>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('imageInput').onchange = function(evt) {
            const [file] = this.files;
            if (file) {
                const preview = document.getElementById('imagePreview');
                preview.src = URL.createObjectURL(file);
                preview.onload = function() { URL.revokeObjectURL(preview.src); }
            }
        };
    </script>

    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'), {
                toolbar: [ 'heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 'imageUpload', 'blockQuote', '|', 'undo', 'redo' ],
                ckfinder: {
                    uploadUrl: '/api/upload/ckeditor'
                }
            })
            .catch(error => {
                console.error(error);
            });
    </script>
}