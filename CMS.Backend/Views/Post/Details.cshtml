@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xem trước: " + Model.Title;
}

<div class="container mt-4 mb-5" style="max-width: 900px;">

    <div class="mb-4 d-flex justify-content-between align-items-center">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm fw-bold rounded-3">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm shadow-sm fw-bold rounded-3 text-dark">
            <i class="bi bi-pencil-square"></i> Chỉnh sửa bài này
        </a>
    </div>

    <article class="bg-white p-4 p-md-5 rounded-4 shadow-sm border border-secondary border-opacity-25">

        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-3 py-2">
                <i class="bi bi-folder-fill"></i> @(Model.CategoryPost?.Name ?? "Chưa phân loại")
            </span>

            @if (Model.IsPublished)
            {
                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2">
                    <i class="bi bi-globe"></i> Đã xuất bản
                </span>
            }
            else
            {
                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill px-3 py-2">
                    <i class="bi bi-file-earmark-lock"></i> Lưu nháp (Đang ẩn)
                </span>
            }

            <span class="badge bg-info bg-opacity-10 text-dark border border-info rounded-pill px-3 py-2">
                <i class="bi bi-eye"></i> @Model.ViewCount lượt xem
            </span>
        </div>

        <h1 class="display-6 fw-bold text-dark mb-3 lh-base">@Model.Title</h1>

        <div class="text-muted small mb-4 pb-3 border-bottom d-flex flex-wrap gap-4">
            <span><i class="bi bi-calendar3"></i> Ngày đăng: <strong>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</strong></span>
            <span><i class="bi bi-link-45deg"></i> Link SEO: <strong class="font-monospace text-primary">/@Model.Slug</strong></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <div class="lead fw-semibold text-dark mb-4 p-3 bg-light rounded-3 border-start border-4 border-warning fst-italic">
                @Model.Summary
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mb-5 text-center">
                <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm border" alt="@Model.Title" style="max-height: 500px; width: 100%; object-fit: cover;">
            </div>
        }

        <div class="post-content fs-5 text-dark lh-lg">
            @* Dùng @Html.Raw để biên dịch các thẻ HTML từ trình soạn thảo *@
            @Html.Raw(Model.Content)
        </div>

    </article>
</div>

<style>
    /* CSS nội bộ giúp khung hiển thị bài viết trông giống y hệt lúc đăng lên báo */
    .post-content {
        word-wrap: break-word;
    }

        /* Responsive cho ảnh chèn bên trong bài viết */
        .post-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin: 1.5rem 0;
            box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
        }

        /* Tạo khoảng cách đẹp cho các thẻ Heading trong bài */
        .post-content h2, .post-content h3, .post-content h4 {
            font-weight: 700;
            margin-top: 2rem;
            margin-bottom: 1rem;
            color: #2c3e50;
        }

        /* Giãn dòng chuẩn SEO cho đoạn văn */
        .post-content p {
            margin-bottom: 1.5rem;
            text-align: justify;
        }

        .post-content a {
            color: #0d6efd;
            text-decoration: underline;
        }
</style>