@model IEnumerable<CMS.Data.Entities.Post>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark fw-bold m-0 text-uppercase">
            <i class="bi bi-collection-fill text-primary me-2"></i>Quản lý bài viết
        </h3>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Thêm bài viết mới
        </a>
    </div>

    <div class="row">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-light border-0 shadow-sm text-center py-5 rounded-4" role="alert">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-3 opacity-50"></i>
                    <h5 class="text-muted fw-bold">Chưa có bài viết nào!</h5>
                    <p class="text-secondary small">Hãy bấm nút "Thêm bài viết mới" để tạo nội dung đầu tiên.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100 border-0 overflow-hidden transition-all hover-shadow rounded-4">

                        <div class="position-relative overflow-hidden" style="height: 220px; background-color: #f8f9fa;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top w-100 h-100 object-fit-cover" alt="@item.Title">
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 w-100 text-muted">
                                    <i class="bi bi-image fs-1 opacity-25"></i>
                                </div>
                            }

                            <div class="position-absolute top-0 end-0 p-2">
                                @if (item.IsPublished)
                                {
                                    <span class="badge bg-success shadow-sm"><i class="bi bi-globe"></i> Công khai</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary shadow-sm"><i class="bi bi-lock-fill"></i> Bản nháp</span>
                                }
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column p-4">

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill px-3">
                                    <i class="bi bi-folder-fill"></i> @(item.CategoryPost?.Name ?? "Chưa phân loại")
                                </span>
                                <small class="text-muted"><i class="bi bi-eye"></i> @item.ViewCount</small>
                            </div>

                            <h5 class="card-title text-dark fw-bold mb-2 lh-base" title="@item.Title" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Title
                            </h5>

                            <p class="card-text text-muted flex-grow-1 small" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @* ĐÃ SỬA LỖI: Hiển thị Summary thay vì Content chứa HTML *@
                                @(string.IsNullOrEmpty(item.Summary) ? "Không có mô tả ngắn..." : item.Summary)
                            </p>

                            <div class="mt-3 pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> @item.CreatedDate.ToString("dd/MM/yyyy")</small>
                                    <small class="text-primary font-monospace" style="font-size: 0.75rem;">/@item.Slug</small>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info flex-grow-1 fw-bold">Xem</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning flex-grow-1 fw-bold text-dark">Sửa</a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="flex-grow-1"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold">Xóa</button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .transition-all {
        transition: all 0.3s ease;
    }

    .hover-shadow:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 2rem rgba(0,0,0,.15) !important;
    }

    .object-fit-cover {
        object-fit: cover;
    }
</style>