@model IEnumerable<CMS.Data.Entities.Post>

<div class="container mt-4">
    <h2 class="mb-4 text-danger text-center fw-bold">DANH SÁCH BÀI VIẾT THEO DANH MỤC</h2>
    <hr />

    <div class="row">
        @if (Model == null || !Model.Any())
        {
            <!-- Trường hợp danh mục chưa có bài viết nào -->
            <div class="col-12">
                <div class="alert alert-warning text-center" role="alert">
                    Hiện chưa có bài viết nào thuộc danh mục này!
                </div>
            </div>
        }
        else
        {
            <!-- Vòng lặp duyệt qua từng bài viết trong danh sách -->
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <!-- Ảnh đại diện bài viết -->
                        <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height: 200px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <!-- Tên danh mục (Hiển thị mượt mà nhờ lệnh .Include trong Controller) -->
                            <div class="mb-2">
                                <span class="badge bg-info text-dark">@item.Category.Name</span>
                            </div>

                            <!-- Tiêu đề và mô tả ngắn -->
                            <h5 class="card-title text-primary fw-bold">@item.Title</h5>
                            <p class="card-text text-truncate flex-grow-1">@item.Content</p>

                            <!-- Ngày đăng -->
                            <p class="text-muted small mb-3">
                                <i class="bi bi-calendar3"></i> Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                            </p>

                            <!-- Nút Xem chi tiết dẫn đến hàm Details -->
                            <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm mt-auto">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>