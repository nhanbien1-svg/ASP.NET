@model IEnumerable<CMS.Data.Entities.Post>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark fw-bold m-0 text-uppercase">
            <i class="bi bi-collection-fill text-primary me-2"></i>Quản lý bài viết
        </h3>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm bài viết mới
        </a>
    </div>

    <div class="row">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-light border-0 shadow-sm text-center py-5" role="alert">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                    <h5 class="text-muted">Chưa có bài viết nào. Hãy tạo bài viết đầu tiên!</h5>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100 border-0 overflow-hidden transition-all hover-shadow">
                        <div class="overflow-hidden" style="height: 200px;">
                            <img src="@item.ImageUrl" class="card-img-top w-100 h-100 object-fit-cover" alt="@item.Title">
                        </div>

                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">
                                    @(item.Category?.Name ?? "Chưa phân loại")
                                </span>
                            </div>

                            <h5 class="card-title text-dark fw-bold mb-2">@item.Title</h5>
                            <p class="card-text text-muted flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Content
                            </p>

                            <div class="mt-3 pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> @item.CreatedDate.ToString("dd/MM/yyyy")</small>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary flex-grow-1">Xem</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning flex-grow-1">Sửa</a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="flex-grow-1"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Xóa</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .transition-all {
        transition: all 0.3s ease;
    }

    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    .object-fit-cover {
        object-fit: cover;
    }
</style>