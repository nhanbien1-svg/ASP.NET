@model CMS.Data.Entities.User

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm thành viên";
}

<div class="container-fluid mt-4 mb-5">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-primary text-white p-3 rounded-top-4">
            <h5 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i> THÊM THÀNH VIÊN MỚI</h5>
        </div>
        <div class="card-body p-4 p-md-5">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold"></div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Tên đăng nhập (Username)</label>
                        <input asp-for="UserName" class="form-control rounded-pill px-4" placeholder="Ví dụ: admin_nhan" required />
                        <span asp-validation-for="UserName" class="text-danger small ms-2 fw-semibold"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Mật khẩu</label>
                        <input type="password" name="Password" class="form-control rounded-pill px-4" placeholder="••••••••" required minlength="6" />
                        <span class="text-danger small ms-2 fw-semibold">@Html.ValidationMessage("Password")</span>
                        <div class="form-text small text-muted ms-3"><i class="bi bi-info-circle"></i> Mật khẩu tối thiểu 6 ký tự.</div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Họ và Tên</label>
                        <input asp-for="FullName" class="form-control rounded-pill px-4" placeholder="Ví dụ: Biện Văn Nhân" required />
                        <span asp-validation-for="FullName" class="text-danger small ms-2 fw-semibold"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Địa chỉ Email</label>
                        <input asp-for="Email" type="email" class="form-control rounded-pill px-4" placeholder="nhan@thaicms.com" required />
                        <span asp-validation-for="Email" class="text-danger small ms-2 fw-semibold"></span>
                    </div>
                </div>

                <div class="row align-items-center">
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Vai trò (Role)</label>
                        <select asp-for="Role" class="form-select rounded-pill px-4" required>
                            <option value="">-- Chọn quyền hạn --</option>
                            <option value="SuperAdmin">Super Admin (Toàn quyền)</option>
                            <option value="Admin">Admin (Quản trị)</option>
                            <option value="Editor">Biên tập viên (Chỉ đăng bài)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small ms-2 fw-semibold"></span>
                    </div>

                    <div class="col-md-6 mb-4 mt-md-3">
                        <div class="form-check form-switch ms-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="IsActiveSwitch" style="transform: scale(1.3);">
                            <label class="form-check-label fw-bold text-dark ms-2 pt-1" for="IsActiveSwitch">Kích hoạt tài khoản ngay lập tức</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm fw-bold">
                        <i class="bi bi-save me-1"></i> Lưu thông tin
                    </button>
                    <a asp-action="Index" class="btn btn-light border px-4 rounded-pill fw-bold text-secondary hover-bg-secondary">
                        Hủy & Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}