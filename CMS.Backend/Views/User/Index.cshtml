@using CMS.DATA.Entities
@model IEnumerable<User>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-dark fw-bold m-0 text-uppercase">
        <i class="bi bi-people-fill text-primary me-2"></i>Quản lý thành viên
    </h3>

    <a asp-action="Create" class="btn btn-success d-flex align-items-center gap-2 shadow-sm fw-semibold">
        <i class="bi bi-person-plus-fill"></i> Thêm thành viên
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle border-0">
        <thead class="table-light border-bottom">
            <tr class="text-secondary text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                <th style="width: 10%;" class="text-center">ID</th>
                <th style="width: 30%;">Tài khoản / Họ tên</th>
                <th style="width: 30%;">Email</th>
                <th style="width: 15%;" class="text-center">Vai trò</th>
                <th style="width: 15%;" class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold text-secondary">#@item.Id</td>

                        <td>
                            <div class="fw-semibold text-dark">@item.UserName</div>
                            <small class="text-muted">@item.FullName</small>
                        </td>

                        <td>
                            <span class="text-dark">@item.Email</span>
                        </td>

                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.Role) && item.Role.Contains("Quản trị"))
                            {
                                <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded border border-danger-subtle">Quản trị viên</span>
                            }
                            else if (!string.IsNullOrEmpty(item.Role) && item.Role.Contains("biên tập"))
                            {
                                <span class="badge bg-warning-subtle text-warning px-2.5 py-1.5 rounded border border-warning-subtle">Biên tập viên</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary px-2.5 py-1.5 rounded border border-primary-subtle">@item.Role</span>
                            }
                        </td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-1" title="Sửa thông tin">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1" title="Xóa thành viên"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên &quot;@item.UserName&quot; không?');">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-5 text-muted">
                        <i class="bi bi-people fs-2 d-block mb-2 text-secondary"></i>
                        <span>Không tìm thấy thành viên nào trong hệ thống.</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>