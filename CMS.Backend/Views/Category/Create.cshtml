@model CMS.Data.Entities.Category

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h3 class="card-title mb-0 fw-bold text-center">THÊM DANH MỤC MỚI</h3>
        </div>
        <div class="card-body bg-light">
            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên danh mục:</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục... (Ví dụ: Sức Khỏe)" />

                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả:</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả ngắn..."></textarea>

                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                        Quay lại danh sách
                    </a>
                    <button type="submit" class="btn btn-success">
                        Lưu vào hệ thống
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>