@using CMS.Data.Entities
@model IEnumerable<Category>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh sách danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-dark fw-bold m-0 text-uppercase">
        <i class="bi bi-folder text-primary me-2"></i>Quản lý danh mục tin tức
    </h3>

    <a asp-action="Create" class="btn btn-success d-flex align-items-center gap-2 shadow-sm fw-semibold">
        <i class="bi bi-plus-circle-fill"></i> Thêm danh mục mới
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle border-0">
        <thead class="table-light border-bottom">
            <tr class="text-secondary text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                <th style="width: 10%;" class="text-center">ID</th>
                <th style="width: 30%;">Tên danh mục</th>
                <th style="width: 40%;">Mô tả danh mục</th>
                <th style="width: 20%;" class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold text-secondary">#@item.Id</td>
                        <td>
                            <span class="fw-semibold text-dark">@item.Name</span>
                        </td>
                        <td>
                            <span class="text-muted text-truncate d-inline-block" style="max-width: 350px;" title="@item.Description">
                                @(string.IsNullOrEmpty(item.Description) ? "Chưa có mô tả" : item.Description)
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-1" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1" title="Xóa dữ liệu"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục &quot;@item.Name&quot; không?');">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                        <span>Không tìm thấy dữ liệu danh mục nào trong hệ thống.</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>