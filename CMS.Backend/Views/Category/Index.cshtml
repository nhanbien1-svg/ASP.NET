@using CMS.Data.Entities
@model IEnumerable<Category>

@{
    ViewData["Title"] = "Danh sách danh mục";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary m-0">DANH SÁCH DANH MỤC</h2>

        <a asp-action="Create" class="btn btn-success">
            <i class="purple-plus-icon"></i> Tải/Thêm danh mục mới
        </a>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr class="table-dark text-center">
                <th style="width: 10%;">ID</th>
                <th style="width: 30%;">Tên danh mục</th>
                <th style="width: 40%;">Mô tả</th>
                <th style="width: 20%;">Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-2">
                                Sửa
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục &quot;@item.Name&quot; không?');">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Không có dữ liệu hiển thị</td>
                </tr>
            }
        </tbody>
    </table>
</div>