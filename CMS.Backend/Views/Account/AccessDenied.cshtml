@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container-fluid d-flex justify-content-center align-items-center mt-5 pt-4">
    <div class="card shadow-sm border-0 rounded-4 text-center" style="max-width: 550px; width: 100%;">
        <div class="card-body p-5">
            <div class="mb-3">
                <div class="d-inline-flex justify-content-center align-items-center bg-danger bg-opacity-10 rounded-circle" style="width: 120px; height: 120px;">
                    <i class="bi bi-shield-fill-x text-danger" style="font-size: 4rem;"></i>
                </div>
            </div>

            <h1 class="fw-bold text-dark display-4 mb-2">403</h1>
            <h5 class="text-uppercase text-danger fw-bold mb-3 letter-spacing-1">Truy cập bị từ chối</h5>

            <p class="text-muted mb-4 px-3">
                Xin lỗi, tài khoản <strong class="text-dark">@User.Identity?.Name</strong> hiện không có đủ thẩm quyền để truy cập vào khu vực này. <br />
                Vui lòng liên hệ với Quản trị viên cấp cao (Super Admin) nếu bạn cần được cấp quyền.
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-semibold">
                    <i class="bi bi-house-door-fill me-2"></i>Về Bảng điều khiển
                </a>

                <a asp-controller="Account" asp-action="Logout" class="btn btn-light border rounded-pill px-4 py-2 fw-semibold text-secondary hover-bg-secondary">
                    <i class="bi bi-box-arrow-right me-2"></i>Đổi tài khoản
                </a>
            </div>
        </div>
    </div>
</div>