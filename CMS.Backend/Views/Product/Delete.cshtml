@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Ngừng kinh doanh sản phẩm";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-danger rounded-4 border-2">
        <div class="card-header bg-danger text-white py-3 rounded-top-4">
            <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-octagon"></i> Xác nhận ngừng kinh doanh</h4>
        </div>
        <div class="card-body p-4 p-md-5">

            <div class="alert alert-warning border-warning shadow-sm mb-5">
                <h6 class="fw-bold mb-1"><i class="bi bi-info-circle-fill text-warning"></i> Chế độ An toàn dữ liệu (Soft-Delete)</h6>
                <p class="mb-0 small text-dark">
                    Hệ thống áp dụng quy tắc thương mại điện tử: Sản phẩm này sẽ <strong>không bị xóa vĩnh viễn</strong> khỏi cơ sở dữ liệu để tránh làm hỏng lịch sử các đơn hàng cũ. Thay vào đó, nó sẽ được chuyển sang trạng thái <strong>Tạm ẩn (Ngừng kinh doanh)</strong> và lập tức biến mất khỏi giao diện khách hàng.
                </p>
            </div>

            <div class="row g-4 mb-4 align-items-center">
                <div class="col-md-4 text-center d-flex flex-column align-items-center justify-content-center">
                    <span class="fw-bold d-block mb-3 text-muted">Ảnh đại diện sản phẩm:</span>
                    <div class="border bg-light rounded-3 p-2 shadow-sm d-flex align-items-center justify-content-center position-relative" style="width: 220px; height: 220px;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height: 100%; object-fit: contain;" alt="@Model.Name" />
                        }
                        else
                        {
                            <div class="text-muted text-center">
                                <i class="bi bi-image fs-1 d-block opacity-25 mb-2"></i>
                                <small>Không có ảnh</small>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-8">
                    <table class="table table-bordered table-striped mb-0 shadow-sm">
                        <tbody>
                            <tr>
                                <th class="bg-light" style="width: 35%">Mã hệ thống (ID)</th>
                                <td class="fw-bold text-danger">#@Model.Id</td>
                            </tr>
                            <tr>
                                <th class="bg-light align-middle">Tên thiết bị</th>
                                <td class="fw-bold fs-5 text-primary lh-sm">@Model.Name</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Trực thuộc danh mục</th>
                                <td>
                                    <span class="badge bg-secondary px-3 py-2">@(Model.CategoryProduct?.Name ?? "Chưa phân loại")</span>
                                </td>
                            </tr>
                            <tr>
                                <th class="bg-light">Giá bán niêm yết</th>
                                <td class="fw-extrabold text-success fs-5">@Model.Price.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Tồn kho hiện tại</th>
                                <td>
                                    @if (Model.StockQuantity > 0)
                                    {
                                        <span class="text-dark fw-bold">@Model.StockQuantity sản phẩm</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">Hết hàng (0)</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th class="bg-light align-middle">Trạng thái Website</th>
                                <td>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2"><i class="bi bi-eye"></i> Đang hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2"><i class="bi bi-eye-slash"></i> Đang ẩn</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <hr class="my-5 text-secondary opacity-25" />

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-3 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-bold rounded-3">
                        Hủy bỏ & Quay lại
                    </a>
                    <button type="submit" class="btn btn-danger px-5 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-eye-slash-fill"></i> Xác nhận Ẩn sản phẩm
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>