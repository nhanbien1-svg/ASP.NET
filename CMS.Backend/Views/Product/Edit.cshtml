@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-warning border-2 rounded-4">
        <div class="card-header bg-warning text-dark py-3 rounded-top-4">
            <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i> Cập nhật sản phẩm: @Model.Name</h4>
        </div>
        <div class="card-body p-4 p-md-5">

            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm rounded-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />
                <input type="hidden" asp-for="CreatedDate" /> <div class="row g-5">
                    <div class="col-lg-7">
                        <h5 class="fw-bold text-warning border-bottom pb-2 mb-4 text-dark">Thông tin cơ bản</h5>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold">Tên thiết bị/sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control form-control-lg" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="AvailableColors" class="form-label fw-bold">Tùy chọn Màu sắc</label>
                                <input asp-for="AvailableColors" id="AvailableColors" class="form-control" placeholder="Đen, Trắng, Tím" />
                                <div class="mt-2 d-flex flex-wrap gap-1">
                                    <small class="text-muted mt-1 me-1">Gợi ý:</small>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableColors">Đen</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableColors">Trắng</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableColors">Đỏ</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableColors">Xanh dương</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableColors">Vàng</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableColors">Titan</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AvailableStorages" class="form-label fw-bold">Tùy chọn Dung lượng</label>
                                <input asp-for="AvailableStorages" id="AvailableStorages" class="form-control" placeholder="128GB, 256GB" />
                                <div class="mt-2 d-flex flex-wrap gap-1">
                                    <small class="text-muted mt-1 me-1">Gợi ý:</small>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableStorages">64GB</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableStorages">128GB</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableStorages">256GB</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableStorages">512GB</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableStorages">1TB</span>
                                    <span class="badge bg-light text-dark border cursor-pointer suggestion-pill" data-target="AvailableStorages">2TB</span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CategoryProductId" class="form-label fw-bold">Thuộc danh mục <span class="text-danger">*</span></label>
                            <select asp-for="CategoryProductId" class="form-select form-select-lg" asp-items="ViewBag.CategoryProductId" required>
                                <option value="">-- Lựa chọn phân loại danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryProductId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Mô tả thông số chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Specifications" class="form-label fw-bold">Thông số kỹ thuật (Bảng)</label>
                            <textarea asp-for="Specifications" class="form-control" rows="4" placeholder='Dạng JSON: {"Màn hình":"OLED", "Chip":"A18"}'></textarea>
                            <span asp-validation-for="Specifications" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 p-3 bg-light rounded-3 border">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive">
                                <label class="form-check-label ms-2 fw-bold text-dark" asp-for="IsActive">
                                    Cho phép hiển thị ngay trên Website
                                </label>
                            </div>
                            <small class="text-muted d-block mt-1 ms-5">Tắt công tắc này để đưa sản phẩm vào chế độ tạm ẩn (Ngừng kinh doanh).</small>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <h5 class="fw-bold text-warning border-bottom pb-2 mb-4 text-dark">Bán hàng & Hình ảnh</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="Price" class="form-control fw-bold text-success" type="number" step="1000" min="0" value="@Convert.ToInt32(Model.Price)" required />
                                    <span class="input-group-text fw-bold">₫</span>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng kho <span class="text-danger">*</span></label>
                                <input asp-for="StockQuantity" class="form-control" type="number" min="0" required />
                                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group mb-4 p-4 border rounded-4 bg-light text-center h-100">
                            <label class="control-label fw-bold mb-3 d-block fs-5">Ảnh đại diện sản phẩm</label>

                            <div class="mb-3 d-flex justify-content-center">
                                <div class="border bg-white rounded-3 p-2 shadow-sm d-flex align-items-center justify-content-center position-relative overflow-hidden" style="width: 250px; height: 250px;">
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img id="imagePreview" src="@Model.ImageUrl" class="img-fluid" style="max-height: 100%; object-fit: contain;" alt="Current Image" />
                                    }
                                    else
                                    {
                                        <img id="imagePreview" src="https://via.placeholder.com/250?text=Chưa+có+ảnh" class="img-fluid opacity-50" style="max-height: 100%; object-fit: contain;" alt="No Image" />
                                    }
                                </div>
                            </div>

                            <input type="file" name="imageFile" class="form-control mb-3" accept="image/*" id="imageInput" />
                            
                            <label class="control-label fw-bold mb-2 mt-2 d-block">Thêm ảnh phụ (Gallery)</label>
                            <input type="file" name="additionalImages" class="form-control" accept="image/*" multiple />

                            <small class="text-muted mt-3 d-block text-start">
                                💡 Mẹo: Bỏ trống nếu muốn giữ lại ảnh đại diện cũ. Chọn ảnh mới sẽ tự động thay thế. Các ảnh phụ mới tải lên sẽ được thêm vào danh sách ảnh phụ.
                            </small>
                        </div>
                    </div>
                </div>

                <hr class="my-5 text-secondary" />

                <div class="d-flex justify-content-end gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-bold rounded-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning text-dark px-5 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle"></i> Cập nhật thay đổi
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <style>
        .cursor-pointer { cursor: pointer; }
        .suggestion-pill:hover { background-color: #e9ecef !important; }
    </style>

    <script>
        document.getElementById('imageInput').onchange = function(evt) {
            const [file] = this.files;
            if (file) {
                const preview = document.getElementById('imagePreview');
                preview.src = URL.createObjectURL(file);
                // Giải phóng bộ nhớ sau khi ảnh đã load xong
                preview.onload = function() {
                    URL.revokeObjectURL(preview.src);
                }
            }
        };

        // Xử lý khi click vào các gợi ý (pill)
        document.querySelectorAll('.suggestion-pill').forEach(pill => {
            pill.addEventListener('click', function() {
                const targetId = this.getAttribute('data-target');
                const inputElement = document.getElementById(targetId);
                const valueToAdd = this.innerText;

                let currentValue = inputElement.value.trim();
                
                // Nếu đã có giá trị, kiểm tra xem đã có từ này chưa
                if (currentValue) {
                    const valuesArray = currentValue.split(',').map(v => v.trim());
                    if (!valuesArray.includes(valueToAdd)) {
                        inputElement.value = currentValue + ', ' + valueToAdd;
                    }
                } else {
                    inputElement.value = valueToAdd;
                }
            });
        });
    </script>
}

