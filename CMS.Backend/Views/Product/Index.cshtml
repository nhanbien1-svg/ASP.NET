@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Quản lý Kho Sản phẩm";
}

<div class="container-fluid mt-4 mb-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-box-seam"></i> Quản lý Kho Sản phẩm</h2>
            <p class="text-muted small mt-1">Quản lý danh sách thiết bị, giá bán, tồn kho và trạng thái hiển thị trên Website.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 fw-bold shadow-sm d-flex align-items-center gap-2 rounded-3">
            <i class="bi bi-plus-lg"></i> Thêm sản phẩm mới
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Ảnh</th>
                        <th style="width: 25%;">Tên thiết bị</th>
                        <th style="width: 15%;">Danh mục</th>
                        <th style="width: 15%;">Giá bán</th>
                        <th style="width: 12%;">Tồn kho</th>
                        <th style="width: 13%;">Trạng thái</th>
                        <th class="text-end pe-4" style="width: 12%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="border bg-white rounded-3 p-1 shadow-sm d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="img-fluid rounded-2" style="max-height: 100%; object-fit: contain;" alt="@item.Name" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-image opacity-50"></i></span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <strong class="text-dark d-block text-truncate" style="max-width: 250px;" title="@item.Name">@item.Name</strong>
                                    <small class="text-muted">ID: #@item.Id</small>
                                </td>

                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-dark border px-2 py-1 text-truncate" style="max-width: 150px;" title="@(item.CategoryProduct?.Name)">
                                        @(item.CategoryProduct?.Name ?? "Chưa phân loại")
                                    </span>
                                </td>

                                <td>
                                    <span class="text-success fw-bold">@item.Price.ToString("N0") ₫</span>
                                </td>

                                <td>
                                    @if (item.StockQuantity > 10)
                                    {
                                        <span class="text-dark fw-medium">@item.StockQuantity</span>
                                    }
                                    else if (item.StockQuantity > 0)
                                    {
                                        <span class="text-warning fw-bold" title="Cần nhập thêm hàng">@item.StockQuantity (Sắp hết)</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">Hết hàng</span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                                            <i class="bi bi-eye"></i> Đang bán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">
                                            <i class="bi bi-eye-slash"></i> Đang ẩn
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm text-dark" title="Chỉnh sửa sản phẩm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Ngừng kinh doanh / Ẩn sản phẩm" onclick="return confirm('Bạn có muốn Ẩn (Ngừng kinh doanh) sản phẩm này?');">
                                            <i class="bi bi-eye-slash-fill"></i>
                                        </a>
                                        <a asp-action="HardDelete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Xóa vĩnh viễn khỏi hệ thống" onclick="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn XÓA VĨNH VIỄN sản phẩm này không? Hành động này không thể hoàn tác!');">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <div class="mb-3"><i class="bi bi-box-seam fs-1 text-secondary opacity-50"></i></div>
                                <h5 class="fw-bold">Chưa có sản phẩm nào trong kho</h5>
                                <p class="small">Hãy bấm nút "Thêm sản phẩm mới" để bắt đầu đăng bán.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
