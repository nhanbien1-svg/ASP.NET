@model CMS.Backend.Models.DashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển - Admin";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Bảng điều khiển</h2>
            <p class="text-muted mb-0">Tổng quan hoạt động của hệ thống</p>
        </div>
        <div>
            <a href="#" class="btn btn-primary rounded-pill shadow-sm px-4">
                <i class="bi bi-download me-2"></i>Báo cáo
            </a>
        </div>
    </div>

    <!-- Hàng thống kê -->
    <div class="row g-4 mb-5">
        <!-- Doanh thu -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white h-100 rounded-4 border-0 shadow-sm hover-elevate">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="mb-1 text-white-50 fw-semibold text-uppercase" style="letter-spacing: 1px; font-size: 0.85rem;">Tổng Doanh Thu</p>
                        <h3 class="fw-bold mb-0">@Model.TotalRevenue.ToString("N0") <small class="fs-6 fw-normal">VNĐ</small></h3>
                    </div>
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-currency-dollar fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Đơn hàng -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white h-100 rounded-4 border-0 shadow-sm hover-elevate">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="mb-1 text-white-50 fw-semibold text-uppercase" style="letter-spacing: 1px; font-size: 0.85rem;">Đơn Hàng</p>
                        <h3 class="fw-bold mb-0">@Model.TotalOrders</h3>
                    </div>
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-cart-check fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Sản phẩm -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark h-100 rounded-4 border-0 shadow-sm hover-elevate">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="mb-1 text-dark text-opacity-75 fw-semibold text-uppercase" style="letter-spacing: 1px; font-size: 0.85rem;">Sản Phẩm</p>
                        <h3 class="fw-bold mb-0">@Model.TotalProducts</h3>
                    </div>
                    <div class="rounded-circle bg-dark bg-opacity-10 p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-box-seam fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
        <!-- Bài viết -->
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white h-100 rounded-4 border-0 shadow-sm hover-elevate">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="mb-1 text-white-50 fw-semibold text-uppercase" style="letter-spacing: 1px; font-size: 0.85rem;">Bài Viết</p>
                        <h3 class="fw-bold mb-0">@Model.TotalPosts</h3>
                    </div>
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-file-earmark-text fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng dữ liệu -->
    <div class="row g-4">
        <!-- Đơn hàng mới nhất -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-receipt text-primary me-2"></i>Đơn hàng mới nhất</h5>
                    <a asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">Xem tất cả</a>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted">
                                <tr>
                                    <th class="fw-semibold rounded-start border-0">Mã ĐH</th>
                                    <th class="fw-semibold border-0">Khách hàng</th>
                                    <th class="fw-semibold border-0">Ngày đặt</th>
                                    <th class="fw-semibold border-0 text-end rounded-end">Tổng tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(Model.RecentOrders != null && Model.RecentOrders.Any())
                                {
                                    foreach(var order in Model.RecentOrders)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">#@order.Id</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-primary fw-bold me-2" style="width: 32px; height: 32px; font-size: 14px;">
                                                        @(string.IsNullOrEmpty(order.ShippingName) ? "U" : order.ShippingName.Substring(0,1).ToUpper())
                                                    </div>
                                                    <span class="fw-medium text-dark">@order.ShippingName</span>
                                                </div>
                                            </td>
                                            <td class="text-muted small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="fw-bold text-end">@order.TotalAmount.ToString("N0") ₫</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">Không có đơn hàng nào gần đây.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bài viết mới nhất -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-newspaper text-info me-2"></i>Tin tức mới xuất bản</h5>
                    <a asp-controller="Post" asp-action="Index" class="btn btn-sm btn-outline-info rounded-pill px-3">Tất cả</a>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3">
                        @if (Model.RecentPosts != null && Model.RecentPosts.Any())
                        {
                            foreach (var post in Model.RecentPosts)
                            {
                                <div class="d-flex gap-3 align-items-center p-3 rounded-3 hover-bg-light transition-all border border-light">
                                    <div class="rounded-3 overflow-hidden flex-shrink-0" style="width: 80px; height: 60px;">
                                        <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "https://via.placeholder.com/80x60" : post.ImageUrl)" class="w-100 h-100 object-fit-cover" alt="Thumb" />
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <h6 class="mb-1 text-truncate fw-bold">
                                            <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="text-dark text-decoration-none">@post.Title</a>
                                        </h6>
                                        <div class="d-flex align-items-center text-muted small">
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary me-2 px-2 py-1"><i class="bi bi-tag-fill me-1"></i>@(post.CategoryPost?.Name ?? "Chưa phân loại")</span>
                                            <span><i class="bi bi-clock me-1"></i>@post.CreatedDate.ToString("dd/MM")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">Chưa có bài viết nào.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa; /* Màu nền xám nhạt cho toàn trang dashboard */
    }
    
    .hover-elevate {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-elevate:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    
    .hover-bg-light:hover {
        background-color: #f8f9fa;
        border-color: #e9ecef !important;
    }
</style>