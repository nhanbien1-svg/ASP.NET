@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Trang Chủ - Cập Nhật Tin Tức";
}

<div class="text-center mb-5 mt-4">
    <h1 class="display-4 fw-extrabold text-primary" style="letter-spacing: -1px;">Welcome_Biện Văn Nhân_Buổi 01 Thực hành</h1>
    <p class="fs-5 text-muted mt-3">Learn about <a href="https://learn.microsoft.com/aspnet/core" class="text-decoration-none fw-bold border-bottom border-primary border-2 pb-1">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="container mt-5 mb-5">
    <div class="d-flex align-items-center justify-content-center gap-3 mb-3">
        <i class="bi bi-lightning-charge-fill text-warning fs-2"></i>
        <h2 class="text-center text-danger fw-bold m-0" style="letter-spacing: 1px;">TIN TỨC MỚI NHẤT</h2>
        <i class="bi bi-lightning-charge-fill text-warning fs-2"></i>
    </div>
    <hr style="width: 80px; margin: 0 auto 40px auto; border-top: 4px solid #dc3545; border-radius: 5px;" />

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            // Vòng lặp duyệt qua đúng 3 bài viết lấy từ Controller
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 d-flex align-items-stretch">
                    <div class="card shadow-sm h-100 border-0 rounded-4 overflow-hidden transition-all hover-card">

                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/350x200?text=No+Image" : item.ImageUrl)"
                                 class="card-img-top w-100" alt="@item.Title" style="height: 220px; object-fit: cover;">

                            <div class="position-absolute top-0 start-0 m-3">
                                <span class="badge bg-danger shadow-sm px-3 py-2 fs-6 rounded-pill">
                                    <i class="bi bi-tag-fill me-1"></i> @(item.CategoryPost?.Name ?? "Chưa phân loại")
                                </span>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-dark mb-3 lh-base" style="-webkit-line-clamp: 2; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden;">
                                <a asp-controller="Post" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark hover-text-primary">
                                    @item.Title
                                </a>
                            </h5>

                            <p class="card-text text-secondary flex-grow-1" style="-webkit-line-clamp: 3; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(item.Summary) ? "Đang cập nhật nội dung..." : item.Summary)
                            </p>

                            <div class="mt-3">
                                <a asp-controller="Post" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm fw-bold rounded-pill px-4">
                                    Đọc tiếp <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>

                        <div class="card-footer bg-white text-muted small border-top-0 px-4 pb-4 pt-0 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-calendar3 text-primary me-1"></i> @item.CreatedDate.ToString("dd/MM/yyyy")</span>

                            <span class="badge bg-light text-dark border"><i class="bi bi-eye"></i> @item.ViewCount lượt xem</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center text-muted p-5 bg-light rounded-4 border border-dashed">
                    <i class="bi bi-newspaper display-1 opacity-25 mb-3 d-block"></i>
                    <h5 class="fw-bold">Chưa có bản tin nào!</h5>
                    <p class="mb-0">Hiện tại hệ thống chưa có bài viết nào được đăng tải công khai.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* CSS hiệu ứng Hover cho Card trên Trang chủ */
    .hover-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .hover-text-primary:hover {
        color: #0d6efd !important;
    }

    .border-dashed {
        border-style: dashed !important;
        border-width: 2px !important;
    }
</style>