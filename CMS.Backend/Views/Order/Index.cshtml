@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    // Layout đã được thiết lập mặc định trong _ViewStart.cshtml
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark m-0">
        <i class="bi bi-box-seam me-2 text-primary"></i> DANH SÁCH ĐƠN ĐẶT HÀNG
    </h3>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th scope="col" class="py-3 px-4 text-muted" style="width: 10%">MÃ ĐH</th>
                        <th scope="col" class="py-3 px-4 text-muted" style="width: 25%">KHÁCH HÀNG</th>
                        <th scope="col" class="py-3 px-4 text-muted" style="width: 20%">NGÀY ĐẶT</th>
                        <th scope="col" class="py-3 px-4 text-muted" style="width: 15%">TỔNG TIỀN</th>
                        <th scope="col" class="py-3 px-4 text-muted" style="width: 15%">TRẠNG THÁI</th>
                        <th scope="col" class="py-3 px-4 text-end text-muted" style="width: 15%">HÀNH ĐỘNG</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="border-bottom">
                                <td class="px-4">
                                    <span class="fw-bold text-dark">#@item.Id</span>
                                </td>

                                <td class="px-4">
                                    @if (item.Customer != null)
                                    {
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold text-dark">@item.Customer.FullName</span>
                                            <span class="text-muted small">@item.Customer.Phone</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Khách vô danh</span>
                                    }
                                </td>

                                <td class="px-4">
                                    <span class="text-secondary">@item.OrderDate.ToString("dd/MM/yyyy")</span><br />
                                    <span class="text-muted small">@item.OrderDate.ToString("HH:mm")</span>
                                </td>

                                <td class="px-4">
                                    <span class="fw-bold text-danger">@item.TotalAmount.ToString("N0") đ</span>
                                </td>

                                <td class="px-4">
                                    @switch (item.Status)
                                    {
                                        case 0:
                                            <span class="badge rounded-pill bg-warning text-dark px-3 py-2">Chờ duyệt</span>
                                            break;
                                        case 1:
                                            <span class="badge rounded-pill bg-info text-white px-3 py-2">Đang giao</span>
                                            break;
                                        case 2:
                                            <span class="badge rounded-pill bg-success text-white px-3 py-2">Đã giao</span>
                                            break;
                                        case 3:
                                            <span class="badge rounded-pill bg-danger text-white px-3 py-2">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge rounded-pill bg-secondary text-white px-3 py-2">Lỗi trạng thái</span>
                                            break;
                                    }
                                </td>

                                <td class="px-4 text-end">
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary shadow-none fw-semibold">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted mb-3">
                                    <i class="bi bi-inbox fs-1"></i>
                                </div>
                                <h6 class="fw-semibold">Chưa có đơn đặt hàng nào</h6>
                                <p class="text-muted small mb-0">Khi khách hàng đặt hàng, dữ liệu sẽ hiển thị tại đây.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>