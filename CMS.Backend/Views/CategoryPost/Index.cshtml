@using CMS.Data.Entities
@model IEnumerable<CategoryPost>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Danh mục Tin tức";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-danger border-2 rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <strong>Lỗi:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-dark fw-bold m-0 text-uppercase">
        <i class="bi bi-folder-fill text-primary me-2"></i>Quản lý danh mục tin tức
    </h3>

    <a asp-action="Create" class="btn btn-success d-flex align-items-center gap-2 shadow-sm fw-bold rounded-3">
        <i class="bi bi-plus-circle-fill"></i> Thêm danh mục mới
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle border-0 mb-0">
            <thead class="table-light border-bottom">
                <tr class="text-secondary text-uppercase fw-bold" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                    <th style="width: 8%;" class="text-center">ID</th>
                    <th style="width: 25%;">Tên danh mục & Link SEO</th>
                    <th style="width: 20%;">Cấp độ / Trực thuộc</th>
                    <th style="width: 20%;">Mô tả</th>
                    <th style="width: 12%;" class="text-center">Trạng thái</th>
                    <th style="width: 15%;" class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold text-secondary">#@item.Id</td>

                            <td>
                                <strong class="text-dark fs-6 d-block">@item.Name</strong>
                                <small class="text-muted font-monospace"><i class="bi bi-link-45deg"></i> /@item.Slug</small>
                            </td>

                            <td>
                                @if (item.ParentId == null)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">
                                        <i class="bi bi-hdd-network"></i> Danh mục gốc
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Thuộc: <strong class="text-dark">@item.ParentCategory?.Name</strong>
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="text-muted text-truncate d-inline-block" style="max-width: 200px;" title="@item.Description">
                                    @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                                </span>
                            </td>

                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-eye"></i> Hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary"><i class="bi bi-eye-slash"></i> Đang ẩn</span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm d-flex align-items-center" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục &quot;@item.Name&quot; không?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center" title="Xóa dữ liệu">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary opacity-50"></i>
                            <h6 class="fw-bold text-dark">Chưa có danh mục tin tức nào!</h6>
                            <p class="small mb-0">Hãy bấm nút "Thêm danh mục mới" ở góc trên để bắt đầu cấu trúc hệ thống.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>