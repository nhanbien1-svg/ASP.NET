@model CMS.Data.Entities.Customer
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Xóa Khách Hàng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-danger text-white p-4 text-center rounded-top-4">
                    <i class="bi bi-exclamation-triangle-fill display-4 d-block mb-2"></i>
                    <h4 class="mb-0 fw-bold">XÓA KHÁCH HÀNG</h4>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="fs-5 mb-4">Bạn chắc chắn muốn xóa vĩnh viễn khách hàng <strong class="text-danger">@Model.FullName</strong>?</p>
                    <div class="bg-light p-3 rounded-3 text-start mb-4 border text-muted">
                        <div><strong>Email:</strong> @Model.Email</div>
                        <div><strong>Số điện thoại:</strong> @(Model.Phone ?? "N/A")</div>
                        <div><strong>Ngày tạo:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy")</div>
                    </div>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold px-4">Xác nhận Xóa</button>
                        <a asp-action="Index" class="btn btn-light btn-lg border rounded-pill fw-bold text-secondary ms-2 px-4">Hủy bỏ</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>