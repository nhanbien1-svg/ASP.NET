@model IEnumerable<CMS.Data.Entities.Customer>
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Quản lý Khách hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark m-0"><i class="bi bi-person-bounding-box text-warning me-2"></i>QUẢN LÝ KHÁCH HÀNG</h3>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold"><i class="bi bi-plus-circle-fill me-1"></i> Thêm mới</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm"><i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase small text-muted">
                        <tr><th class="ps-4">ID</th><th>Khách hàng</th><th>Liên hệ</th><th class="text-center">Trạng thái</th><th class="text-center">Hành động</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.FullName</div>
                                    <div class="small text-muted"><i class="bi bi-clock me-1"></i>Tham gia: @item.CreatedDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope text-primary me-1"></i>@item.Email</div>
                                    <div class="small text-muted mt-1"><i class="bi bi-telephone me-1"></i>@(string.IsNullOrEmpty(item.Phone) ? "Chưa cập nhật" : item.Phone)</div>
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-1">Hoạt động</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill px-3 py-1">Đã khóa</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3"><i class="bi bi-pencil-square"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>