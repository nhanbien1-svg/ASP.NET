@model CMS.Data.Entities.CategoryProduct

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container mt-4">
    <div class="card shadow-sm border-warning rounded-3 border-2">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="mb-0 fw-bold">✏️ Chỉnh sửa danh mục: @Model.Name</h4>
        </div>
        <div class="card-body p-4">

            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group mb-4">
                            <label asp-for="Name" class="control-label fw-bold mb-2">Tên danh mục <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control form-control-lg" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ParentId" class="control-label fw-bold mb-2">Thuộc danh mục (Cha)</label>
                            <select asp-for="ParentId" class="form-select" asp-items="ViewBag.ParentCategories">
                                <option value="">-- Đây là Danh mục gốc (Không có cha) --</option>
                            </select>
                            <small class="text-muted mt-1 d-block">Lưu ý: Không thể chọn danh mục cha là chính nó.</small>
                            <span asp-validation-for="ParentId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="control-label fw-bold mb-2">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group mb-4 p-4 border rounded-3 bg-light text-center h-100">
                            <label class="control-label fw-bold mb-3 d-block">Ảnh Logo / Biểu tượng hiện tại</label>

                            <div class="mb-3 d-flex justify-content-center">
                                <div class="border bg-white rounded p-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 150px; height: 150px;">
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img id="imagePreview" src="@Model.ImageUrl" class="img-fluid" style="max-height: 100%; object-fit: contain;" alt="Current Logo" />
                                    }
                                    else
                                    {
                                        <img id="imagePreview" src="https://via.placeholder.com/150?text=No+Logo" class="img-fluid" style="max-height: 100%; object-fit: contain;" alt="No Logo" />
                                    }
                                </div>
                            </div>

                            <input type="file" name="uploadImage" id="uploadImage" class="form-control" accept="image/*" onchange="previewImage(event)" />
                            <small class="text-muted mt-3 d-block text-start">
                                💡 <strong>Mẹo:</strong> Bỏ trống nếu bạn muốn giữ nguyên Logo cũ. Nếu chọn ảnh mới, ảnh cũ sẽ tự động bị xóa khỏi hệ thống.
                            </small>
                        </div>
                    </div>
                </div>

                <hr class="my-4 text-secondary" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-5 fw-bold py-2 shadow-sm text-dark">
                        <i class="bi bi-save"></i> Cập nhật thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Hủy & Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function() {
                var output = document.getElementById('imagePreview');
                output.src = reader.result;
            };
            if(event.target.files[0]) {
                reader.readAsDataURL(event.target.files[0]);
            }
        }
    </script>
}